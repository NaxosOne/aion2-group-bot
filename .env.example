# Copie ce fichier en `.env` puis remplis les valeurs.

# Token du bot, récupéré sur https://discord.com/developers/applications
# (onglet "Bot" -> "Reset Token"). NE LE PARTAGE JAMAIS.
DISCORD_TOKEN=

# Optionnel : l'ID de ton serveur Discord. Si renseigné, les commandes
# slash apparaissent instantanément sur ce serveur (sinon la propagation
# globale peut prendre jusqu'à 1 heure).
# Clic droit sur le nom du serveur -> "Copier l'identifiant du serveur"
# (il faut activer le mode développeur dans Paramètres > Avancés).
GUILD_ID=

# Fuseau horaire utilisé pour interpréter les dates tapées dans /sortie.
TIMEZONE=Europe/Paris

# Combien de minutes avant le début de la sortie le rappel est envoyé.
REMINDER_MINUTES=15

# Publication automatique des dispos de la semaine (activée par /dispo hebdo) :
# jour (0 = lundi ... 6 = dimanche) et heure de publication.
DISPO_JOUR=0
DISPO_HEURE=9

# Chemin du fichier SQLite où sont stockées les sorties et inscriptions.
DB_PATH=data/bot.db
