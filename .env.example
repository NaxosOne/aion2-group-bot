# Copy this file to `.env` and fill in the values.

# Bot token, from https://discord.com/developers/applications
# ("Bot" tab -> "Reset Token"). NEVER SHARE IT.
DISCORD_TOKEN=

# Optional: your Discord server ID. If set, slash commands appear instantly
# on that server (otherwise global propagation can take up to 1 hour).
# Right-click the server name -> "Copy Server ID"
# (enable Developer Mode in Settings > Advanced first).
GUILD_ID=

# Timezone used to interpret the schedules typed in /event.
TIMEZONE=Europe/Paris

# How many minutes before an event's start the reminder is sent.
REMINDER_MINUTES=15

# Automatic weekly availability board (enabled with /availability weekly):
# day (0 = Monday ... 6 = Sunday) and hour of posting.
AVAILABILITY_DAY=0
AVAILABILITY_HOUR=9

# Custom role emojis (optional). Upload the PNGs from assets/emoji/ in the
# developer portal (your application -> Emojis tab), then paste each emoji
# code below, e.g. EMOJI_TANK=<:tank:123456789012345678>.
# Leave empty to keep the default Unicode emojis.
EMOJI_TANK=
EMOJI_HEAL=
EMOJI_DPS=

# Event-type emojis work the same way (embeds and messages only — Discord
# shows slash-command choice lists and the bot status as plain text, where
# only Unicode works).
EMOJI_DUNGEON=
EMOJI_RAID=
EMOJI_BATTLEGROUND=
EMOJI_PVP=
EMOJI_RIFT=
EMOJI_ABYSS=
EMOJI_OTHER=

# Class emojis, same idea (used by the class menus, the roster and the
# character picker shown when you sign up with several characters).
EMOJI_GLADIATOR=
EMOJI_TEMPLAR=
EMOJI_ASSASSIN=
EMOJI_RANGER=
EMOJI_SORCERER=
EMOJI_SPIRITMASTER=
EMOJI_CLERIC=
EMOJI_CHANTER=
# EMOJI_FIST_FIGHTER=   (once the class launches)

# Path of the SQLite file storing events and sign-ups.
DB_PATH=data/bot.db
